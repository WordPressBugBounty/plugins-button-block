{"translation-revision-date":"YEAR-MO-DA HO:MI+ZONE","generator":"WP-CLI\/2.12.0","source":"build\/index.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"en","plural-forms":"nplurals=2; plural=(n != 1);"},"Pricing":[""],"Settings":[""],"Image":[""],"Video":[""],"Type:":[""],"Help":[""],"Shadow:":[""],"Default":[""],"None":[""],"Copied Successfully!":[""],"Copy To Clipboard":[""],"Flip Right":[""],"Flip Up":[""],"Flip Down":[""],"Zoom In":[""],"Zoom In Up":[""],"Zoom In Down":[""],"Zoom In Left":[""],"Zoom In Right":[""],"Fade Up":[""],"Fade Down":[""],"Fade Left":[""],"Fade Right":[""],"Flip Left":[""],"Button Text":[""],"Button Type:":[""],"Animation":[""],"Duration (Speed) (s):":[""],"Animation duration of speed in seconds":[""],"Additional":[""],"ID:":[""],"Enter additional ID":[""],"CSS:":[""],"Enter additional CSS":[""],"Popup Options":[""],"Enable dynamic popup content: show image, audio, video, custom blocks, documents, and iframes on button click.":[""],"Button":[""],"Hover Colors:":[""],"Padding:":[""],"Button Alignment":[""],"Button in left":[""],"Button in center":[""],"Button in right":[""],"Text:":[""],"Action:":[""],"URL:":[""],"Open link in new tab":[""],"Download Button":[""],"Make sure the URL\/link is downloadable!":[""],"This is an experimental feature, and it may not work reliably every time.":[""],"Source":[""],"Unlock popup action, security settings (password, email, role-based protection), custom link relation, referrer policy, and custom download file name with Premium version.":[""],"Elements":[""],"Upload Icon?":[""],"Enter Icon URL":[""],"Select Icon":[""],"Tooltip Text:":[""],"If you want to add tooltip on button, type text rather then leave empty.":[""],"Unlock icon position, tooltip position, and device-specific visibility settings with Premium version.":[""],"Design":[""],"Button Full Width?":[""],"Button Size:":[""],"Feature Comparison":[""],"Welcome":[""],"Demos":[""],"Paste Anywhere":[""],"Paste the copied shortcode (e.g. <code>[btn_block id=123]<\/code>) into any post, page, widget area, or layout using the <strong>Shortcode<\/strong> block.":[""],"Design Stylish, Interactive, and Multi-Functional Buttons":[""],"Go to <strong>Button Block &rsaquo; Add New<\/strong>, design your button, and publish it. Copy the shortcode <code>[btn_block id=YOUR_ID]<\/code> from the list table.":[""],"Get multi-functional buttons. The Button Block plugin comes up with many useful styling options that make you happy to build responsive, interactive, stylish buttons in a few clicks.":[""],"Add Shortcode Widget":[""],"Open the Elementor editor on any page. Search for the <strong>Shortcode<\/strong> widget and drag it to your desired section\/column.":[""],"Enter & Preview":[""],"Paste your shortcode (e.g. <code>[btn_block id=123]<\/code>) into the Shortcode input box to preview the stylized button live on the canvas.":[""],"Theme \/ PHP":[""],"Create a Button Post":[""],"Go to <strong>Button Block &rsaquo; Add New<\/strong>, customize your button, and copy the shortcode <code>[btn_block id=YOUR_ID]<\/code> from the post list.":[""],"Button Block Generator":[""],"Open Theme File":[""],"Open the PHP template file in your theme where you want the button to appear (e.g. <code>header.php<\/code>, <code>footer.php<\/code>, <code>single.php<\/code>, or custom template files).":[""],"Render via do_shortcode":[""],"Add <code>&lt;?php echo do_shortcode('[btn_block id=YOUR_ID]'); ?&gt;<\/code> (replace <em>YOUR_ID<\/em> with the actual post ID) to render the button.":[""],"View More Changelogs":[""],"Popup with image, video, docs, or blocks.":[""],"Protect a button by password, email, or role.":[""],"Collect and browse captured email leads.":[""],"Set a custom file name for the download.":[""],"Add rel and referrer policy attributes.":[""],"Place the icon and tooltip on any side.":[""],"Hide the button on desktop, tablet, or mobile.":[""],"See All Demos":[""],"Tooltip":[""],"Icon":[""],"Customize":[""],"Animations":[""],"Popup":[""],"Buy Now \u279c":[""],"Best Value":[""],"All shortcode posts (button-block post type)":[""],"Plugin settings":[""],"Start Now":[""],"Styling":[""],"Features":[""],"Add the Button Block":[""],"Open the block editor on any post or page. Click the <strong>+<\/strong> icon in the top-left corner or type <strong>\/Button Block<\/strong> to find and insert the Button Block.":[""],"Open Editor":[""],"Customize Style":[""],"Use the block settings in the sidebar to style your button. You can choose layouts, customize alignment, add hover effects, set typography, adjust border-radius, background, and text colors.":[""],"Configure Button Action":[""],"Configure what happens when a user clicks the button. Set the link URL, choose whether it opens a popup (Pro), triggers a file download (Pro), or set custom rel attributes and referrer policies.":[""],"Style & Publish":[""],"Use the design controls to customize hover states, custom shadows, and animations. When satisfied, publish or update the page.":[""],"ShortCode":[""],"Open Button Block Generator":[""],"Go to <strong>Button Block &rsaquo; Add New<\/strong> (or the Button Block CPT list) in your WordPress admin menu to create a reusable button.":[""],"Configure the Block":[""],"In the editor, design and customize your button using the block options in the sidebar. Give it a title for easy reference and publish it.":[""],"Copy the Shortcode":[""],"After publishing, go to the <strong>Button Block<\/strong> list table. You will see a <strong>ShortCode<\/strong> column displaying <code>[btn_block id=POST_ID]<\/code>. Click it to copy to your clipboard.":[""],"Login Protected":[""],"Alternate":[""],"Author":[""],"Bookmark":[""],"External":[""],"License":[""],"Next":[""],"No Follow":[""],"No Opener":[""],"Prev":[""],"Search":[""],"Tag":[""],"No Referrer":[""],"No Referrer When Downgrade":[""],"Origin":[""],"Origin When Cross Origin":[""],"Same Origin":[""],"Strict Origin When Cross Origin"